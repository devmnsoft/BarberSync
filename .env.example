# Copie para .env (ignorado pelo Git) e use uma senha local forte.
POSTGRES_DB=barber
POSTGRES_USER=barbersync
POSTGRES_PASSWORD=
# Gere um segredo aleatório com pelo menos 32 caracteres; nunca o versione.
Jwt__SigningKey=
# Escopo obrigatório usado somente pelas superfícies anônimas PublicWeb/Totem.
# Informe UUIDs reais do tenant e da unidade deste deployment.
BarberSync__DefaultTenantId=
BarberSync__DefaultBranchId=
