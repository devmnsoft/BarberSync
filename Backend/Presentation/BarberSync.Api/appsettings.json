{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext"
    ],
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "BarberSync.Api",
    "Audience": "BarberSync.Clients",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Redis": {
    "Enabled": false,
    "ConnectionString": ""
  },
  "Messaging": {
    "Enabled": false,
    "Provider": "InMemory",
    "ConnectionString": ""
  }
}
