@{ Layout = null; }
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Entrar — BarberSync</title>
    <link rel="stylesheet" href="~/css/admin-login-premium.css" asp-append-version="true" />
</head>
<body>
    <main class="login-shell">
        <section class="login-brand-panel" aria-label="BarberSync">
            <img src="~/img/logo-barbersync-white.svg" alt="BarberSync" />
            <div><p>GESTÃO QUE ACOMPANHA O SEU RITMO</p><h1>Seu salão em movimento. Sua gestão sob controle.</h1><span>Agenda, atendimento, equipe e resultados em uma experiência integrada.</span></div>
        </section>
        <section class="login-form-panel">
            <form id="loginForm" class="login-form" autocomplete="on">
                <div class="mobile-logo"><img src="~/img/logo-barbersync.svg" alt="BarberSync" /></div>
                <p class="eyebrow">ACESSO SEGURO</p>
                <h2>Bem-vindo de volta</h2>
                <p class="form-intro">Entre para acompanhar a operação da sua unidade.</p>
                <div class="login-error" role="alert" data-login-error hidden></div>
                <label for="email">E-mail</label>
                <input type="email" id="email" name="email" autocomplete="username" placeholder="voce@seusalao.com.br" required />
                <div class="password-label"><label for="password">Senha</label><a href="/Account/ForgotPassword">Esqueci minha senha</a></div>
                <div class="password-field"><input type="password" id="password" name="password" autocomplete="current-password" placeholder="Digite sua senha" required /><button type="button" data-toggle-password aria-label="Mostrar senha">Mostrar</button></div>
                <button class="login-submit" type="submit"><span>Entrar</span></button>
                <p class="privacy-note"><a href="/Help/Setup">Primeira configuração</a> · <a href="/Admin/Diagnostics">Diagnóstico local</a></p>
                <small class="privacy-note">Ao entrar, você concorda com as políticas de segurança e privacidade da sua organização.</small>
            </form>
        </section>
    </main>
    <script src="~/js/admin-login-premium.js" asp-append-version="true"></script>
</body>
</html>
