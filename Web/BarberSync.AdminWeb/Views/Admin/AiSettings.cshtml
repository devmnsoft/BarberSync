@{ ViewData["Title"] = "Configuração de IA"; Layout = "~/Views/Shared/_AdminLayout.cshtml"; }
<main class="recognition" data-ai-settings><header class="recognition-hero"><div><span class="badge">Área segura</span><h1>Provider de IA</h1><p>Consulte a configuração sem expor tokens ou segredos.</p></div><button class="btn btn-primary" data-test-provider>Testar conexão</button></header><div class="privacy-alert"><strong>Seguro por padrão</strong><span>UnconfiguredAiProvider permanece ativo até configuração explícita no ambiente do servidor.</span></div><section class="recognition-grid"><article class="recognition-card"><h2>Status</h2><div data-provider-status class="loading" aria-live="polite">Carregando…</div></article><article class="recognition-card"><h2>Último teste</h2><div data-provider-test>O provider ainda não foi testado nesta execução.</div></article><article class="recognition-card"><h2>Ambientes conectados</h2><div data-provider-resources></div></article><article class="recognition-card"><h2>Proteção de credenciais</h2><p>Tokens e segredos nunca são devolvidos por esta tela.</p><strong data-secrets-status>Validando…</strong></article></section><div data-provider-error aria-live="assertive"></div></main>
@section Styles { <link rel="stylesheet" href="~/css/admin-service-recognition.css" asp-append-version="true" /> }
@section Scripts { <script src="~/js/admin-ai-settings.js" asp-append-version="true"></script> }
