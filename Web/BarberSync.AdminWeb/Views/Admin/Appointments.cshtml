@{ ViewData["Title"] = "Agenda"; Layout = "~/Views/Shared/_AdminLayout.cshtml"; }
<section class="bs-page-header page-header"><div><h1>Agenda</h1><p>Organize horários, acompanhe chegadas e conduza cada atendimento.</p></div><div class="page-actions"><button class="btn btn-light" data-agenda-refresh>Atualizar</button><button class="btn btn-primary" data-agenda-new>Novo agendamento</button></div></section>
<section class="bs-filter-bar panel" aria-label="Filtros da agenda">
  <label>Período<input class="bs-date-input" type="date" data-filter-date></label>
  <label>Profissional<select class="bs-select" data-filter-professional><option value="">Todos</option></select></label>
  <label>Serviço<select class="bs-select" data-filter-service><option value="">Todos</option></select></label>
  <label>Status<select class="bs-select" data-filter-status><option value="">Todos</option><option>Scheduled</option><option>Confirmed</option><option>CheckedIn</option><option>InService</option><option>Finished</option><option>Cancelled</option><option>NoShow</option></select></label>
  <label>Origem<select class="bs-select" data-filter-origin><option value="">Todas</option><option>Admin</option><option>PublicWeb</option><option>Totem</option><option>Mobile</option></select></label>
</section>
<nav class="agenda-modes" aria-label="Visualização"><button class="btn btn-primary" data-mode="today">Hoje</button><button class="btn btn-light" data-mode="day">Dia</button><button class="btn btn-light" data-mode="week">Semana</button><button class="btn btn-light" data-mode="list">Lista</button></nav>
<section class="bs-skeleton panel" data-agenda-loading>Carregando agenda…</section>
<section class="bs-error-state panel" data-agenda-error hidden><h2>Não foi possível carregar a agenda</h2><p data-error-detail></p><button class="btn btn-primary" data-agenda-refresh>Tentar novamente</button></section>
<section class="bs-empty-state panel" data-agenda-empty hidden><h2>Nenhum agendamento no período</h2><p>Ajuste os filtros ou crie um novo horário.</p><button class="btn btn-primary" data-agenda-new>Novo agendamento</button></section>
<section class="agenda-grid" data-agenda-list aria-live="polite"></section>
<div class="bs-drawer-backdrop" data-agenda-drawer hidden><aside class="bs-drawer" aria-labelledby="agenda-drawer-title">
 <form data-agenda-form><header><h2 id="agenda-drawer-title">Novo agendamento</h2><button type="button" class="modal-close" data-drawer-close>×</button></header>
 <div class="bs-form-field"><label>Cliente</label><select name="clientId" required><option value="">Selecione o cliente</option></select><small class="bs-field-error"></small></div>
 <div class="bs-form-field"><label>Telefone</label><input class="bs-phone-input" name="phone" inputmode="tel" placeholder="(11) 99999-9999"></div>
 <div class="bs-form-field"><label>Serviço</label><select name="serviceId" required><option value="">Selecione o serviço</option></select></div>
 <div class="bs-form-field"><label>Profissional</label><select name="professionalId" required><option value="">Selecione o profissional</option></select></div>
 <div class="form-row"><div class="bs-form-field"><label>Data</label><input type="date" name="date" required></div><div class="bs-form-field"><label>Hora</label><input type="time" name="time" required></div></div>
 <div class="bs-form-field"><label>Origem</label><select name="origin"><option>Admin</option><option>PublicWeb</option><option>Totem</option><option>Mobile</option></select></div>
 <div class="bs-form-field"><label>Observação</label><textarea name="notes" placeholder="Preferências e informações relevantes"></textarea></div>
 <div class="bs-form-actions"><button type="button" class="btn btn-light" data-drawer-close>Cancelar</button><button class="btn btn-primary" type="submit">Criar agendamento</button></div>
 </form></aside></div>
@section Scripts { <script src="~/js/admin-appointments.js" asp-append-version="true"></script> }
