@{ ViewData["Title"] = "Caixa"; Layout = "~/Views/Shared/_AdminLayout.cshtml"; }
<section class="page-header"><div><h1 class="page-title">Caixa operacional</h1><p class="page-subtitle">Abertura, fechamento, sangria, suprimento e conciliação por forma de pagamento.</p></div><div class="page-actions"><button class="btn btn-primary" data-cash-action="open" disabled>Abrir caixa</button><button class="btn btn-light" data-cash-action="close" disabled>Fechar caixa</button></div></section>
<section class="dashboard-grid" id="cashKpis"></section>
<section class="panel"><div class="panel-header"><h3>Movimentações do caixa</h3><span class="badge badge-info" id="cashStatus">Consultando</span></div><div id="cashFeedback" class="bs-empty" role="status"><div class="bs-skeleton" style="width:100%;max-width:560px"></div><strong>Carregando caixa atual</strong><span>Os valores serão exibidos após a consulta segura à operação.</span></div><div class="action-grid"><button class="btn btn-light" data-cash-action="sangria" disabled>Sangria</button><button class="btn btn-light" data-cash-action="suprimento" disabled>Suprimento</button><button class="btn btn-light" data-cash-action="entrada" disabled>Entrada</button><button class="btn btn-light" data-cash-action="saida" disabled>Saída</button></div><div class="table-responsive"><table class="table admin-table"><thead><tr><th>Hora</th><th>Tipo</th><th>Valor</th><th>Forma</th></tr></thead><tbody id="cashRows"></tbody></table></div></section>
@section Scripts { <script src="~/js/admin-cash.js" asp-append-version="true"></script> }
