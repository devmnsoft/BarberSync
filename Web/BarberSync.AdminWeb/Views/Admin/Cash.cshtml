@{ ViewData["Title"] = "Caixa"; Layout = "~/Views/Shared/_AdminLayout.cshtml"; }
<link rel="stylesheet" href="~/css/admin-pos.css" asp-append-version="true" />
<section class="page-header bs-mobile-stack"><div><h1 class="page-title">Caixa operacional</h1><p class="page-subtitle">Abertura, movimentações e fechamento conferido com dados reais.</p></div><div class="page-actions"><button class="btn btn-light bs-touch-target" id="cashRefresh" type="button">Atualizar</button><button class="btn btn-primary bs-touch-target" data-cash-action="open" type="button">Abrir caixa</button><button class="btn btn-light bs-touch-target" data-cash-action="close" type="button">Fechar caixa</button></div></section>
<div class="pos-alert" id="cashAlert" role="alert" hidden></div>
<section class="dashboard-grid" id="cashKpis"></section>
<section class="panel"><div class="panel-header"><div><h3>Movimentações</h3><small>Timeline do turno atual</small></div><span class="badge badge-info" id="cashStatus">Consultando</span></div><div id="cashFeedback" class="bs-empty" role="status"><div class="bs-skeleton"></div><strong>Carregando caixa atual</strong></div><div class="action-grid"><button class="btn btn-light bs-touch-target" data-cash-action="supply" type="button">Suprimento</button><button class="btn btn-light bs-touch-target" data-cash-action="withdrawal" type="button">Sangria</button><button class="btn btn-light bs-touch-target" data-cash-action="expense" type="button">Despesa</button></div><div class="table-responsive bs-responsive-table"><table class="table admin-table"><thead><tr><th>Data/hora</th><th>Tipo</th><th>Descrição</th><th>Valor</th></tr></thead><tbody id="cashRows"></tbody></table></div></section>
<section class="panel"><div class="panel-header"><h3>Histórico de caixas</h3></div><div class="table-responsive bs-responsive-table"><table class="table admin-table"><thead><tr><th>Abertura</th><th>Status</th><th>Esperado</th><th>Conferido</th><th>Diferença</th></tr></thead><tbody id="cashHistory"><tr><td colspan="5">Carregando histórico…</td></tr></tbody></table></div></section>
<div class="pos-drawer-backdrop" id="cashDrawer" hidden><aside class="pos-drawer bs-drawer-scroll" role="dialog" aria-modal="true" aria-labelledby="cashDrawerTitle"><header><h2 id="cashDrawerTitle">Movimentação</h2><button class="pos-close bs-touch-target" data-close-cash type="button" aria-label="Fechar">×</button></header><form id="cashForm" novalidate><input id="cashAction" type="hidden" /><label>Valor<input id="cashAmount" inputmode="decimal" required /></label><label id="cashCategoryField" hidden>Categoria<input id="cashCategory" maxlength="80" /></label><label id="cashReasonField">Motivo<textarea id="cashReason" rows="3" maxlength="300"></textarea></label><div class="bs-cash-close-grid" id="cashCloseSummary" hidden><div><span>Saldo esperado</span><strong id="cashExpected">R$ 0,00</strong></div><div><span>Diferença</span><strong id="cashDifference">R$ 0,00</strong></div></div><small class="field-error" id="cashFormError"></small><div class="pos-drawer-actions"><button class="btn btn-light" data-close-cash type="button">Cancelar</button><button class="btn btn-primary" id="cashSubmit" type="submit">Confirmar</button></div></form></aside></div>
@section Scripts { <script src="~/js/admin-cash.js" asp-append-version="true"></script> }
