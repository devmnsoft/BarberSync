@{ ViewData["Title"] = "Clientes"; Layout = "~/Views/Shared/_AdminLayout.cshtml"; }
<main data-clients-page>
  <header class="page-header bs-page-toolbar bs-mobile-stack">
    <div><p class="pos-eyebrow">Relacionamento</p><h1 class="page-title">Clientes</h1><p class="page-subtitle">Cadastros operacionais carregados exclusivamente pela API.</p></div>
    <div class="page-actions"><button class="btn btn-light bs-touch-target" data-clients-refresh>Atualizar</button><button class="btn btn-primary bs-touch-target" data-clients-new>Novo cliente</button></div>
  </header>
  <section class="panel">
    <div class="module-toolbar"><label class="sr-only" for="ClientsSearch">Buscar cliente</label><input id="ClientsSearch" class="form-control" type="search" placeholder="Buscar por nome, telefone ou e-mail" /></div>
    <div class="bs-responsive-table"><table class="table admin-table"><thead><tr><th>Cliente</th><th>Contato</th><th>Status</th><th>Ações</th></tr></thead><tbody data-clients-rows><tr><td colspan="4">Carregando…</td></tr></tbody></table></div>
    <div class="bs-premium-error" data-clients-error hidden><h2>Clientes indisponíveis</h2><p data-clients-error-detail></p><small>Identificador: <span data-clients-trace>não informado</span></small><br><button class="btn btn-primary" data-clients-retry>Tentar novamente</button></div>
  </section>
  <div class="admin-modal-backdrop" data-clients-modal hidden><form class="admin-modal bs-drawer-scroll" data-clients-form>
    <div class="modal-header"><h2>Novo cliente</h2><button type="button" class="modal-close" data-clients-close aria-label="Fechar">×</button></div>
    <div class="form-grid form-grid-2"><label>Nome *<input name="name" required /></label><label>Telefone *<input name="phone" type="tel" required /></label><label>E-mail<input name="email" type="email" /></label><label>WhatsApp<input name="whatsapp" type="tel" /></label></div>
    <p class="admin-field-error" data-clients-form-error hidden></p><div class="modal-actions"><button type="button" class="btn btn-light" data-clients-close>Cancelar</button><button type="submit" class="btn btn-primary">Salvar cliente</button></div>
  </form></div>
</main>
@section Styles { <link rel="stylesheet" href="~/css/admin-client360.css" asp-append-version="true" /> }
@section Scripts { <script src="~/js/admin-clients.js" asp-append-version="true"></script> }
