@{
    ViewData["Title"] = "Visão Geral";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var hour = DateTime.Now.Hour;
    var greeting = hour < 12 ? "Bom dia" : hour < 18 ? "Boa tarde" : "Boa noite";
}
<section class="dashboard-hero">
    <div>
        <p class="eyebrow">OPERAÇÃO DE HOJE</p>
        <h1>@greeting, <span data-user-name>Administrador</span></h1>
        <p>Unidade: <strong data-dashboard-unit>Principal</strong> <span class="separator">•</span> Hoje, @DateTime.Now.ToString("dd 'de' MMMM 'de' yyyy", new System.Globalization.CultureInfo("pt-BR"))</p>
    </div>
    <div class="quick-actions" aria-label="Ações rápidas">
        <a class="btn btn-primary" href="/Admin/Appointments?new=true">Novo agendamento</a>
        <a class="btn btn-light" href="/Admin/Operations?new=true">Novo atendimento</a>
        <a class="btn btn-light" href="/Admin/Cash?action=open">Abrir caixa</a>
        <a class="btn btn-dark" href="/Admin/ServiceOrders?new=true">Nova comanda</a>
    </div>
</section>

<div class="dashboard-loading" data-dashboard-loading role="status"><span class="loading-pulse"></span>Carregando indicadores da operação...</div>
<section class="dashboard-error" data-dashboard-error hidden>
    <div><strong>Não foi possível carregar a visão operacional.</strong><p>Verifique a conexão com a API e tente novamente.</p></div>
    <button class="btn btn-light" type="button" data-dashboard-retry>Tentar novamente</button>
</section>

<section class="premium-kpi-grid" data-dashboard-kpis aria-label="Indicadores principais" hidden></section>

<div class="dashboard-columns" data-dashboard-content hidden>
    <section class="premium-panel operation-now">
        <header><div><p class="eyebrow">TEMPO REAL</p><h2>Operação agora</h2></div><a href="/Admin/Operations">Ver atendimento</a></header>
        <div class="operation-tabs" role="tablist">
            <button class="active" data-operation-filter="waiting">Aguardando <span data-count="waiting">0</span></button>
            <button data-operation-filter="inService">Em atendimento <span data-count="inService">0</span></button>
            <button data-operation-filter="payment">Pagamento <span data-count="payment">0</span></button>
            <button data-operation-filter="late">Atrasados <span data-count="late">0</span></button>
            <button data-operation-filter="next">Próximos <span data-count="next">0</span></button>
        </div>
        <div class="operation-list" data-operation-list></div>
    </section>

    <aside class="dashboard-side">
        <section class="premium-panel">
            <header><div><p class="eyebrow">ASSISTENTE BARBERSYNC</p><h2>O que merece atenção hoje</h2></div></header>
            <div class="insight-list" data-dashboard-insights></div>
        </section>
        <section class="premium-panel">
            <header><div><p class="eyebrow">PRIORIDADES</p><h2>Alertas acionáveis</h2></div><a href="/Admin/Notifications">Ver todos</a></header>
            <div class="alert-list" data-dashboard-alerts></div>
        </section>
    </aside>
</div>

@section Styles { <link rel="stylesheet" href="~/css/admin-dashboard-premium.css" asp-append-version="true" /> }
@section Scripts { <script src="~/js/admin-dashboard-premium.js" asp-append-version="true"></script> }
