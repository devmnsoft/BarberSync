@{ ViewData["Title"] = "Financeiro Executivo"; Layout = "~/Views/Shared/_AdminLayout.cshtml"; }
<section class="dashboard-hero executive-hero"><div><p class="eyebrow">FINANCEIRO</p><h1>Fluxo executivo</h1><p>Receita realizada, compromissos, recorrência e divergências sem projeções fabricadas.</p></div><div class="quick-actions"><a class="btn btn-light" href="/Admin/Finance?new=true">Lançamento manual</a><a class="btn btn-primary" href="/AdminApi/executive/export.csv">Exportar CSV</a></div></section>
<div class="dashboard-loading" data-financial-loading>Consultando lançamentos financeiros…</div><section class="dashboard-error" data-financial-error hidden><div><strong>Financeiro indisponível.</strong><p data-financial-message></p><code data-financial-trace></code></div><button class="btn btn-light" data-financial-retry>Tentar novamente</button></section>
<section class="premium-kpi-grid" data-financial-kpis hidden></section><section class="premium-panel" data-financial-content hidden><header><div><p class="eyebrow">TIMELINE</p><h2>Resumo por origem</h2></div><a href="/Admin/Finance">Abrir detalhes</a></header><div class="financial-timeline" data-financial-timeline></div></section>
@section Styles { <link rel="stylesheet" href="~/css/admin-dashboard-premium.css" asp-append-version="true" /> }
@section Scripts { <script src="~/js/admin-financial.js" asp-append-version="true"></script> }
