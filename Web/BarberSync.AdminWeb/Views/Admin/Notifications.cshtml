@{ ViewData["Title"] = "Notificações"; Layout = "~/Views/Shared/_AdminLayout.cshtml"; }
<section class="saas7-hero" data-notifications-page><div><span class="badge">Sistema / Notificações</span><h1>Central de notificações</h1><p>Alertas operacionais reais da unidade ativa, com confirmação de leitura persistida pela API.</p></div><div class="saas7-actions"><span class="badge"><strong data-notification-count>0</strong> não lidas</span><button class="btn btn-gold" type="button" data-read-all>Marcar todas como lidas</button></div></section>
<section class="saas7-grid"><article class="saas7-card wide"><h2>Alertas da operação</h2><div class="saas7-list" data-notifications-list aria-live="polite"></div></article><article class="saas7-card"><h2>Como os alertas funcionam</h2><p>Estoque, caixa, agenda, compras e benefícios publicam notificações respeitando o tenant e a unidade autenticada.</p><p class="inline-alert">A leitura só é confirmada depois que a API persiste a alteração.</p></article></section>
@section Scripts { <script src="~/js/admin-notifications.js" asp-append-version="true"></script> }
