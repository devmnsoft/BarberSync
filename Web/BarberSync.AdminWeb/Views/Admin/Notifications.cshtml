@{ ViewData["Title"] = "Notificações"; Layout = "~/Views/Shared/_AdminLayout.cshtml"; }
<section class="saas7-hero" data-notifications-page><div><span class="badge">Sistema / Notificações</span><h1>Central de notificações</h1><p>Alertas operacionais reais da unidade ativa, com confirmação de leitura persistida pela API.</p></div><div class="saas7-actions"><span class="badge"><strong data-notification-count>0</strong> não lidas</span><button class="btn btn-gold" type="button" data-read-all>Marcar todas como lidas</button></div></section>
<section class="saas7-card"><div class="form-grid"><label>Prioridade<select data-notification-filter="priority"><option value="">Todas</option><option>Critical</option><option>High</option><option>Normal</option></select></label><label>Tipo<input data-notification-filter="type" placeholder="Ex.: RecognitionSuggestionPending"></label><label>Status<select data-notification-filter="status"><option value="">Todos</option><option value="unread">Não lidas</option><option value="read">Lidas</option></select></label><label>Unidade<input data-notification-filter="branch" placeholder="ID da unidade"></label></div></section>
<section class="saas7-grid"><article class="saas7-card wide"><h2>Alertas da operação</h2><div class="saas7-list" data-notifications-list aria-live="polite"></div></article><article class="saas7-card"><h2>Como os alertas funcionam</h2><p>Estoque crítico, caixa prolongado, espera, pré-comandas, IA, pacotes, assinaturas, compras, contas, comissões, cashback, VIP, atrasos e check-in publicam alertas acionáveis.</p><p class="inline-alert">Sugestões de IA geram alertas ao serem criadas, ao ultrapassarem 30 minutos e depois da confirmação ou rejeição humana. A leitura só é confirmada depois que a API persiste a alteração.</p></article></section>
@section Scripts { <script src="~/js/admin-notifications.js" asp-append-version="true"></script> }
