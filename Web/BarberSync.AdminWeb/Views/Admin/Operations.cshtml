@{ ViewData["Title"] = "Atendimento ao Vivo"; Layout = "~/Views/Shared/_AdminLayout.cshtml"; }
<section class="bs-page-header page-header"><div><h1>Atendimento ao Vivo</h1><p>Acompanhe chegadas, execução e pagamento em tempo real.</p></div><div class="page-actions"><select data-live-origin><option value="">Todas as origens</option><option>Admin</option><option>PublicWeb</option><option>Totem</option><option>Mobile</option></select><button class="btn btn-primary" data-live-refresh>Atualizar</button></div></section>
<section class="bs-error-state panel" data-live-error hidden><h2>Operação indisponível</h2><p data-live-error-detail></p><button class="btn btn-primary" data-live-refresh>Tentar novamente</button></section>
<section class="operation-board" data-live-board aria-live="polite"><div class="bs-skeleton panel">Carregando atendimentos…</div></section>
@section Scripts { <script src="~/js/admin-operations.js" asp-append-version="true"></script> }
