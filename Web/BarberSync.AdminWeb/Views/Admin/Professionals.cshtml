@{ ViewData["Title"] = "Equipe"; Layout = "~/Views/Shared/_AdminLayout.cshtml"; }
@section Styles { <link rel="stylesheet" href="~/css/admin-team.css" asp-append-version="true" /> }
<section class="team-hero">
 <div><span class="eyebrow">OPERAÇÃO & PESSOAS</span><h1>Equipe</h1><p>Profissionais, serviços, escala e bloqueios em uma visão operacional.</p></div>
 <div class="page-actions"><button class="btn btn-light" data-team-refresh>Atualizar</button><button class="btn btn-primary" data-team-new>Novo profissional</button></div>
</section>
<section class="team-toolbar panel" aria-label="Filtros de equipe">
 <label>Buscar<input type="search" data-team-search placeholder="Nome, função ou especialidade"></label>
 <label>Status<select data-team-status><option value="">Todos</option><option value="Active">Ativos</option><option value="Inactive">Inativos</option></select></label>
 <span class="team-count" data-team-count>0 profissionais</span>
</section>
<section class="bs-skeleton panel" data-team-loading>Carregando equipe da unidade…</section>
<section class="bs-error-state panel" data-team-error hidden><h2>Não foi possível carregar a equipe</h2><p>Confira a conexão com a API e tente novamente.</p><button class="btn btn-primary" data-team-refresh>Tentar novamente</button></section>
<section class="bs-empty-state panel" data-team-empty hidden><h2>Sua equipe começa aqui</h2><p>Cadastre o primeiro profissional e configure serviços e escala.</p><button class="btn btn-primary" data-team-new>Cadastrar profissional</button></section>
<section class="team-grid" data-team-grid aria-live="polite"></section>

<div class="bs-drawer-backdrop" data-team-drawer hidden><aside class="bs-drawer team-drawer">
 <form data-team-form><header><div><span class="eyebrow">PERFIL 360</span><h2 data-team-title>Novo profissional</h2></div><button type="button" class="modal-close" data-team-close>×</button></header>
  <nav class="team-tabs"><button type="button" class="active" data-tab="data">Dados</button><button type="button" data-tab="services">Serviços</button><button type="button" data-tab="schedule">Agenda</button><button type="button" data-tab="block">Bloqueios</button></nav>
  <section data-pane="data"><div class="form-row"><label>Nome completo<input name="name" required maxlength="180"></label><label>Cargo / função<input name="role" required maxlength="80"></label></div><div class="form-row"><label>Telefone<input name="phone" inputmode="tel"></label><label>E-mail<input name="email" type="email"></label></div><div class="form-row"><label>Documento<input name="document"></label><label>Vínculo<select name="employmentType"><option>CLT</option><option>MEI</option><option>Autônomo</option><option>Parceiro</option></select></label></div><div class="form-row"><label>Data de entrada<input name="admissionDate" type="date" required></label><label>Status<select name="status"><option value="Active">Ativo</option><option value="Inactive">Inativo</option></select></label></div><label>Especialidades<input name="specialties" placeholder="Corte, barba, coloração"></label></section>
  <section data-pane="services" hidden><p class="pane-help">Somente serviços ativos da unidade podem ser vinculados.</p><div class="service-checklist" data-service-list></div></section>
  <section data-pane="schedule" hidden><p class="pane-help">Configure expediente e pausa. A agenda recusará horários fora desta grade.</p><div data-schedule-list></div></section>
  <section data-pane="block" hidden><div class="form-row"><label>Início<input name="blockStart" type="datetime-local"></label><label>Fim<input name="blockEnd" type="datetime-local"></label></div><label>Motivo<input name="blockReason" maxlength="30"></label><label>Descrição<textarea name="blockDescription"></textarea></label><button type="button" class="btn btn-secondary" data-create-block>Criar bloqueio</button><div class="block-list" data-block-list></div></section>
  <footer class="drawer-actions"><button type="button" class="btn btn-light" data-team-close>Cancelar</button><button class="btn btn-primary" type="submit">Salvar alterações</button></footer>
 </form>
</aside></div>
@section Scripts { <script src="~/js/admin-team.js" asp-append-version="true"></script> }
