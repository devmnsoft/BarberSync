@{ ViewData["Title"] = "Relatórios Executivos"; Layout = "~/Views/Shared/_AdminLayout.cshtml"; }
<section class="dashboard-hero executive-hero"><div><p class="eyebrow">GESTÃO EXECUTIVA</p><h1>Relatórios com dados reais</h1><p>Indicadores consolidados exclusivamente para o tenant e a unidade autenticados.</p></div><div class="quick-actions"><button class="btn btn-light" type="button" data-report-print>Salvar PDF</button><a class="btn btn-primary" href="/AdminApi/executive/export.csv" download>Exportar CSV</a></div></section>
<form class="executive-filters" data-report-filters><label>Período<input type="date" name="from" /></label><label>Até<input type="date" name="to" /></label><label>Visão<select name="view"><option value="owner">Executiva</option><option value="reception">Recepção</option></select></label><button class="btn btn-dark" type="submit">Aplicar filtros</button></form>
<div class="dashboard-loading" data-report-loading role="status">Carregando dados do relatório…</div>
<section class="dashboard-error" data-report-error hidden><div><strong>Relatório indisponível.</strong><p data-report-error-message></p><code data-report-trace></code></div><button class="btn btn-light" data-report-retry>Tentar novamente</button></section>
<section class="premium-kpi-grid" data-report-kpis hidden></section>
<section class="premium-panel" data-report-content hidden><header><div><p class="eyebrow">DISTRIBUIÇÃO REAL</p><h2>Comparativo dos indicadores</h2></div></header><div class="executive-chart" data-report-chart></div><div class="table-responsive"><table class="table admin-table"><thead><tr><th>Indicador</th><th>Valor</th><th>Escopo</th></tr></thead><tbody data-report-table></tbody></table></div></section>
@section Styles { <link rel="stylesheet" href="~/css/admin-dashboard-premium.css" asp-append-version="true" /> }
@section Scripts { <script src="~/js/admin-reports.js" asp-append-version="true"></script> }
