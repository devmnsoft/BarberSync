@{
    ViewData["Title"] = "Comandas e PDV";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin-service-orders.css" asp-append-version="true" />
}

<main class="bs-pos" data-pos-root aria-busy="true">
    <header class="bs-pos-header">
        <div>
            <span class="bs-eyebrow">Operação de vendas</span>
            <h1>Comandas e PDV</h1>
            <p>Venda serviços e produtos, aplique benefícios e receba com segurança.</p>
        </div>
        <div class="bs-pos-header-actions">
            <select class="bs-field" data-order-picker aria-label="Selecionar comanda"></select>
            <button class="btn btn-light bs-touch-target" type="button" data-refresh>Atualizar</button>
            <button class="btn btn-primary bs-touch-target" type="button" data-open-order>Abrir comanda</button>
        </div>
    </header>

    <nav class="bs-pos-tabs" aria-label="Etapa do PDV">
        <button class="is-active" type="button" data-pos-tab="catalog">Catálogo</button>
        <button type="button" data-pos-tab="order">Comanda <span data-item-count>0</span></button>
        <button type="button" data-pos-tab="payment">Pagamento</button>
    </nav>

    <div class="bs-pos-state" data-pos-state role="status">Carregando dados da operação…</div>

    <section class="bs-pos-grid">
        <article class="bs-pos-panel bs-safe-scroll" data-pos-panel="catalog">
            <div class="bs-panel-heading"><div><span class="bs-step">01</span><h2>Catálogo</h2></div></div>
            <label class="bs-search"><span>Buscar</span><input type="search" data-catalog-search placeholder="Serviço ou produto" autocomplete="off" /></label>
            <div class="bs-filter-pills" role="group" aria-label="Filtrar catálogo">
                <button class="is-active" type="button" data-catalog-filter="all">Todos</button>
                <button type="button" data-catalog-filter="service">Serviços</button>
                <button type="button" data-catalog-filter="product">Produtos</button>
            </div>
            <div class="bs-catalog" data-catalog></div>
        </article>

        <article class="bs-pos-panel bs-safe-scroll" data-pos-panel="order">
            <div class="bs-panel-heading"><div><span class="bs-step">02</span><h2>Comanda</h2></div><span class="bs-status" data-order-status>—</span></div>
            <div class="bs-order-meta" data-order-meta>Selecione ou abra uma comanda.</div>
            <div class="bs-order-items" data-order-items></div>
        </article>

        <aside class="bs-pos-panel bs-sticky-summary" data-pos-panel="payment">
            <div class="bs-panel-heading"><div><span class="bs-step">03</span><h2>Resumo</h2></div></div>
            <dl class="bs-totals">
                <div><dt>Subtotal</dt><dd data-subtotal>R$ 0,00</dd></div>
                <div><dt>Descontos</dt><dd data-discount>R$ 0,00</dd></div>
                <div class="bs-total"><dt>Total</dt><dd data-total>R$ 0,00</dd></div>
                <div><dt>Pago</dt><dd data-paid>R$ 0,00</dd></div>
                <div class="bs-balance"><dt>Saldo</dt><dd data-balance>R$ 0,00</dd></div>
            </dl>
            <form class="bs-benefit" data-coupon-form><label>Cupom<input name="code" required maxlength="40" placeholder="Código do cupom" /></label><button class="btn btn-light bs-touch-target" type="submit">Aplicar</button></form>
            <form class="bs-benefit" data-cashback-form><label>Cashback<input name="amount" required min="0.01" step="0.01" type="number" placeholder="0,00" /></label><button class="btn btn-light bs-touch-target" type="submit">Usar</button></form>
            <div class="bs-inline-feedback" data-benefit-feedback aria-live="polite"></div>
            <button class="btn btn-primary bs-receive bs-touch-target" type="button" data-open-payment>Receber pagamento</button>
        </aside>
    </section>
</main>

<div class="bs-drawer-backdrop" data-drawer-backdrop hidden></div>
<aside class="bs-payment-drawer bs-drawer-scroll" data-payment-drawer hidden aria-labelledby="payment-title" aria-modal="true" role="dialog">
    <header><div><span class="bs-eyebrow">Recebimento seguro</span><h2 id="payment-title">Pagamento</h2></div><button type="button" data-close-payment aria-label="Fechar">×</button></header>
    <form data-payment-form novalidate>
        <div data-splits></div>
        <button class="btn btn-light bs-touch-target" type="button" data-add-split>+ Adicionar forma</button>
        <label>Observação <textarea name="notes" rows="3" maxlength="300" placeholder="Opcional"></textarea></label>
        <div class="bs-payment-preview"><span>Total dos splits</span><strong data-split-total>R$ 0,00</strong><span>Troco</span><strong data-change>R$ 0,00</strong></div>
        <div class="bs-form-error" data-payment-error role="alert"></div>
        <button class="btn btn-primary bs-touch-target" type="submit" data-submit-payment>Confirmar recebimento</button>
    </form>
</aside>

<dialog class="bs-open-dialog" data-open-dialog>
    <form method="dialog" data-open-form>
        <header><h2>Abrir comanda</h2><button value="cancel" aria-label="Fechar">×</button></header>
        <label>Cliente<select name="clientId" required></select></label>
        <label>Atendimento (opcional)<input name="appointmentId" type="text" placeholder="ID do atendimento" /></label>
        <label>Observação<textarea name="notes" rows="3" maxlength="300"></textarea></label>
        <div class="bs-form-error" data-open-error role="alert"></div>
        <footer><button class="btn btn-light" value="cancel">Cancelar</button><button class="btn btn-primary" value="default" type="submit">Abrir comanda</button></footer>
    </form>
</dialog>

@section Scripts {
    <script src="~/js/admin-service-orders.js" asp-append-version="true"></script>
}
