@{ ViewData["Title"] = "Reconhecimento de Serviço"; Layout = "~/Views/Shared/_AdminLayout.cshtml"; }
<main class="recognition" data-recognition-page>
 <header class="recognition-hero"><div><span class="badge">IA assistiva · confirmação humana</span><h1>Reconhecimento de serviço</h1><p>Acompanhe sinais operacionais por cadeira. Sugestões nunca são cobranças e só entram na comanda após sua confirmação.</p></div><button class="btn btn-light" data-refresh type="button">Atualizar</button></header>
 <div class="privacy-alert"><strong>Privacidade por padrão</strong><span>Nenhuma imagem ou biometria é exibida ou armazenada nesta fase. Eventos exigem consentimento e respeitam a unidade ativa.</span></div>
 <nav class="recognition-tabs" aria-label="Áreas"><button class="active" data-tab="operation">Operação</button><button data-tab="cameras">Câmeras</button><button data-tab="stations">Cadeiras e ambientes</button><button data-tab="rules">Regras</button></nav>
 <section data-panel="operation"><div class="recognition-grid"><article class="recognition-card"><header><h2>Sugestões aguardando você</h2><span class="badge" data-pending-count>0</span></header><div data-suggestions></div></article><article class="recognition-card"><h2>Timeline de eventos</h2><div class="timeline" data-events></div></article></div></section>
 <section data-panel="cameras" hidden><article class="recognition-card"><h2>Painel de câmeras</h2><form data-create="cameras"><label>Nome<input name="name" required></label><label>Identificador do provider<input name="providerKey"></label><button class="btn btn-primary">Cadastrar câmera</button></form><div data-resource-list="cameras"></div></article></section>
 <section data-panel="stations" hidden><article class="recognition-card"><h2>Cadeiras e ambientes</h2><form data-create="stations"><label>Nome<input name="name" required></label><label>Tipo<select name="type"><option value="Chair">Cadeira</option><option value="Washbasin">Lavatório</option><option value="Room">Ambiente</option></select></label><label>Câmera<input name="cameraDeviceId" type="text" placeholder="ID da câmera"></label><button class="btn btn-primary">Cadastrar ambiente</button></form><div data-resource-list="stations"></div></article></section>
 <section data-panel="rules" hidden><article class="recognition-card"><h2>Regras de reconhecimento</h2><form data-create="rules"><label>Nome<input name="name" required></label><label>Sinais (separados por vírgula)<input name="signals" required></label><label>Serviço ativo (ID)<input name="serviceId" required></label><label>Confiança mínima<input name="minimumConfidence" type="number" min="0" max="1" step=".01" value="0.75"></label><button class="btn btn-primary">Criar regra</button></form><div data-resource-list="rules"></div></article></section>
 <div class="recognition-state" data-state aria-live="polite"></div>
</main>
<dialog data-decision-dialog><form method="dialog"><h2 data-dialog-title>Confirmar sugestão</h2><p data-dialog-copy></p><label data-order-field>Comanda aberta (ID)<input name="serviceOrderId"></label><label data-client-field>Cliente para pré-comanda (ID)<input name="clientId"></label><label data-reason-field>Motivo<textarea name="reason"></textarea></label><label data-preorder-field><input name="createPreOrder" type="checkbox"> Criar pré-comanda controlada se necessário</label><div class="dialog-actions"><button value="cancel" class="btn btn-light">Cancelar</button><button value="confirm" class="btn btn-primary">Confirmar ação</button></div></form></dialog>
@section Styles { <link rel="stylesheet" href="~/css/admin-service-recognition.css" asp-append-version="true" /> }
@section Scripts { <script src="~/js/admin-service-recognition.js" asp-append-version="true"></script> }
