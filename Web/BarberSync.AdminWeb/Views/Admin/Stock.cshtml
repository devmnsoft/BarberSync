@{
    ViewData["Title"] = "Estoque";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<section class="page-header">
    <div><p class="eyebrow">ESTOQUE</p><h1 class="page-title">Movimentações e níveis</h1><p class="page-subtitle">Saldos e alertas carregados da operação da unidade selecionada.</p></div>
    <div class="page-actions"><button class="btn btn-light" type="button" data-admin-refresh="Stock">Atualizar</button><button class="btn btn-primary" type="button" data-admin-new="Stock">Nova movimentação</button></div>
</section>
<section class="admin-module-grid" id="StockCards" aria-live="polite">
    <article class="kpi-card"><div><p class="kpi-label">Carregando estoque</p><div class="bs-skeleton"></div></div></article>
</section>
<section class="panel module-panel">
    <div class="panel-header"><div><h2>Registros operacionais</h2><p>Entradas, saídas e ajustes persistidos pela API.</p></div><span class="badge badge-info">Unidade atual</span></div>
    <div class="table-responsive"><table class="table admin-table"><thead><tr><th>Produto</th><th>Detalhe</th><th>Status</th><th>Ações</th></tr></thead><tbody id="StockRows"><tr><td colspan="4"><div class="bs-skeleton"></div></td></tr></tbody></table></div>
</section>
<div class="admin-modal-backdrop" id="StockModal" hidden>
    <form class="admin-modal" data-admin-form="Stock">
        <div class="modal-header"><h2>Nova movimentação</h2><button type="button" class="modal-close" data-admin-close="Stock" aria-label="Fechar">×</button></div>
        <label>Produto<input name="product" required /></label>
        <label>Tipo<select name="movement" required><option value="Entrada">Entrada</option><option value="Saída">Saída</option><option value="Ajuste">Ajuste</option></select></label>
        <label>Quantidade<input name="quantity" type="number" min="1" required /></label>
        <label>Motivo<textarea name="notes" required></textarea></label>
        <div class="modal-actions"><button type="button" class="btn btn-light" data-admin-close="Stock">Cancelar</button><button class="btn btn-primary" type="submit">Salvar movimentação</button></div>
    </form>
</div>
@section Scripts { <script src="~/js/admin-crud.js" asp-append-version="true"></script><script>window.renderAdminCrudPage('Stock')</script> }
