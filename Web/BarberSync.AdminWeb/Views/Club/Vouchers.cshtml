@{ ViewData["Title"] = "Clube & Vendas"; Layout = "~/Views/Shared/_AdminLayout.cshtml"; }
<main class="club-page" data-club-page="vouchers">
<header class="club-hero"><div><span>Receita recorrente • experiência premium</span><h1>Vouchers</h1><p>Assinaturas, benefícios e vendas conectados à jornada real do cliente.</p></div><button class="club-primary" type="button" data-club-open>Nova operação</button></header>
<nav class="club-tabs" aria-label="Clube & Vendas"><a href="/Club">Visão geral</a><a href="/Club/Plans">Planos</a><a href="/Club/Memberships">Assinaturas</a><a href="/Club/Wallets">Carteiras</a><a href="/Club/GiftCards">Gift cards</a><a href="/Club/Vouchers">Vouchers</a><a href="/Club/Combos">Combos</a><a href="/Club/OnlineSales">Vendas online</a><a href="/Club/Reports">Relatórios</a></nav>
<section class="club-kpis" data-club-kpis><i></i><i></i><i></i><i></i></section><section class="club-panel"><div class="club-filters"><label>Buscar<input type="search" placeholder="Nome, cliente ou status" data-club-search></label><label>Status<select data-club-status><option value="">Todos</option><option>Active</option><option>PendingPayment</option><option>Suspended</option></select></label></div><div data-club-content class="club-empty"><strong>Nenhum registro para exibir</strong><span>Cadastre a primeira operação ou altere os filtros.</span></div></section>
<section class="club-error" data-club-error hidden><strong>Não foi possível concluir.</strong><span data-error-message></span><small>traceId: <b data-trace-id>não informado</b></small></section>
<dialog class="club-modal" data-club-modal><form method="dialog" data-form-validation><header><h2>Nova operação comercial</h2><button value="cancel" aria-label="Fechar">×</button></header><p>Escolha clientes e itens pelas listas; códigos internos nunca são solicitados.</p><label>Cliente<select name="client" required data-option="clients"><option value="">Selecione um cliente</option></select></label><label>Plano<select name="plan" data-option="plans"><option value="">Selecione um plano</option></select></label><label>Valor<input name="amount" type="number" min="0.01" step="0.01" required></label><label>Motivo<textarea name="reason" required></textarea></label><footer><button value="cancel">Cancelar</button><button class="club-primary" value="default" data-club-submit>Confirmar</button></footer></form></dialog>
</main>
@section Styles { <link rel="stylesheet" href="~/css/club.css" asp-append-version="true" /> }
@section Scripts { <script src="~/js/form-validation.js" asp-append-version="true"></script><script src="~/js/club.js" asp-append-version="true"></script> }
