@{var page=(string)(ViewData["InventoryPage"]??"dashboard");var title=(string)(ViewData["Title"]??"Estoque");}
<link rel="stylesheet" href="~/css/inventory.css" asp-append-version="true"/>
<main class="inventory" data-inventory-page="@page"><header class="inventory-hero"><div><small>Estoque avançado e compras</small><h1>@title</h1><p>Operação real, isolada por filial e com rastreabilidade.</p></div><button type="button" class="inventory-button" data-refresh>Atualizar</button></header><div class="inventory-error" role="alert" hidden></div><nav class="inventory-nav" aria-label="Módulo Estoque"><a href="/Inventory">Dashboard</a><a href="/Inventory/Products">Produtos</a><a href="/Inventory/Purchases">Compras</a><a href="/Inventory/Receiving">Recebimento</a><a href="/Inventory/Counts">Inventário</a><a href="/Inventory/Transfers">Transferências</a><a href="/Inventory/Replenishment">Reposição</a><a href="/Inventory/ServiceInputs">Insumos por serviço</a><a href="/Inventory/Reports">Relatórios</a></nav><section data-inventory-content aria-live="polite"><p class="inventory-empty">Carregando dados…</p></section></main>
<script defer src="~/js/form-validation.js" asp-append-version="true"></script><script defer src="~/js/inventory.js" asp-append-version="true"></script>
