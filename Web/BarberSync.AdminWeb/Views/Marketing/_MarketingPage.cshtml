@{Layout="~/Views/Shared/_AdminLayout.cshtml";var page=(string)(ViewData["MarketingPage"]??"Index");}
<link rel="stylesheet" href="~/css/marketing.css" asp-append-version="true" />
<section class="marketing-shell" data-marketing-page="@page">
<header class="marketing-hero"><div><span class="marketing-eyebrow">Growth workspace</span><h1>Marketing Studio</h1><p>Segmente clientes reais, publique ofertas e atribua cada conversão com segurança.</p></div><a class="marketing-export" href="/api/marketing/reports/export">Exportar CSV</a></header>
<nav class="marketing-nav" aria-label="Marketing Studio"><a href="/Marketing">Visão geral</a><a href="/Marketing/Segments">Segmentos</a><a href="/Marketing/Campaigns">Campanhas</a><a href="/Marketing/Journeys">Jornadas</a><a href="/Marketing/LandingPages">Landings</a><a href="/Marketing/PromoLinks">Links</a><a href="/Marketing/QrCodes">QR Codes</a><a href="/Marketing/Calendar">Calendário</a><a href="/Marketing/Experiments">Experimentos</a><a href="/Marketing/Reports">Relatórios</a></nav>
<div class="marketing-error" data-error hidden><strong>Não foi possível carregar os dados.</strong><span></span><button type="button" data-retry>Tentar novamente</button></div>
<div class="marketing-loading" data-loading><i></i><i></i><i></i><span>Consultando resultados reais…</span></div>
<main data-content hidden>
@if(page=="Index"){
 <div class="marketing-kpis"><article><span>Campanhas ativas</span><strong data-kpi="active_campaigns">—</strong></article><article><span>Clientes impactados</span><strong data-kpi="impacted">—</strong></article><article><span>CTR</span><strong data-kpi="ctr">—</strong></article><article><span>Conversões</span><strong data-kpi="conversions">—</strong></article><article><span>Receita atribuída</span><strong data-kpi="revenue">—</strong></article></div><div class="marketing-grid"><article class="marketing-panel"><h2>Funil comercial</h2><div class="funnel" data-funnel></div></article><article class="marketing-panel"><h2>Próximas decisões</h2><div class="empty">Nenhuma ação baseada em dados disponível no período.</div></article></div>
}else if(page=="Segments"){
 <div class="section-title"><div><h2>Segment builder</h2><p>Critérios versionados e isolados por unidade.</p></div><button type="button" data-open="segment-dialog">Criar segmento</button></div><div class="card-grid" data-list></div><dialog id="segment-dialog"><form data-form="segment"><header><h2>Novo segmento</h2><button type="button" data-close>×</button></header><label>Nome<input name="name" required maxlength="160" /></label><label>Chave pública interna<input name="segmentKey" required pattern="[a-z0-9-]+" /></label><fieldset><legend>Tipo</legend><label><input type="radio" name="segmentType" value="Dynamic" checked /> Dinâmico</label><label><input type="radio" name="segmentType" value="Static" /> Estático</label></fieldset><div class="criteria"><label>Critério<select data-criterion><option value="inactiveDays">Inatividade em dias</option><option value="birthday">Aniversário</option><option value="averageTicket">Ticket médio</option><option value="nps">NPS</option><option value="rating">Rating</option><option value="activeClub">Clube ativo</option><option value="serviceHistory">Serviço realizado</option><option value="pendingBudget">Orçamento pendente</option><option value="portalActive">Portal ativo</option></select></label><label>Operador<select data-operator><option value="gte">Maior ou igual</option><option value="lte">Menor ou igual</option><option value="eq">Igual</option></select></label><label>Valor<input data-value required /></label><button type="button" data-add-criterion>Adicionar critério</button></div><div data-criteria-list></div><input type="hidden" name="status" value="Draft" /><div class="form-error" data-form-error></div><footer><button type="button" data-close>Cancelar</button><button type="submit">Salvar segmento</button></footer></form></dialog>
}else if(page=="Campaigns"){
 <div class="section-title"><div><h2>Campanhas</h2><p>O Communication executa o envio; nenhum provider é simulado.</p></div><button type="button" data-open="campaign-dialog">Nova campanha</button></div><div class="card-grid" data-list></div><dialog id="campaign-dialog" class="wide"><form data-form="campaign"><header><div><span>Wizard · 8 etapas</span><h2>Planejar campanha</h2></div><button type="button" data-close>×</button></header><div class="wizard"><label>1. Objetivo<select name="objective"><option value="Retention">Retenção</option><option value="Reactivation">Reativação</option><option value="Birthday">Aniversário</option><option value="Club">Clube</option><option value="Quality">Qualidade</option><option value="Acquisition">Aquisição</option></select></label><label>2. Segmento<select name="segmentId" required data-option="segments"><option value="">Selecione</option></select></label><label>3. Canal<select name="channelType" required><option value="InApp">In-app</option><option value="Email">E-mail</option><option value="Sms">SMS</option><option value="WhatsApp">WhatsApp</option><option value="Push">Push</option><option value="PublicLink">Link público</option><option value="Manual">Manual</option></select></label><label>4. Template<select name="templateId" data-option="templates"><option value="">Selecione quando exigido</option></select></label><label>5. Oferta<select name="couponId" data-option="coupons"><option value="">Sem cupom</option></select></label><label>6. Landing<select name="landingPageId" data-option="landings"><option value="">Sem landing</option></select></label><label>7. Início<input type="datetime-local" name="startsAt" /></label><label>Fim<input type="datetime-local" name="endsAt" /></label></div><label>8. Nome para revisão<input name="name" required maxlength="180" /></label><div class="form-error" data-form-error></div><footer><button type="button" data-close>Cancelar</button><button type="submit">Salvar rascunho</button></footer></form></dialog>
}else if(page=="Journeys"){
 <div class="section-title"><div><h2>Jornadas automatizadas</h2><p>Gatilhos, condições, ações e janela antirrepetição.</p></div><button type="button" data-open="journey-dialog">Criar jornada</button></div><div class="card-grid" data-list></div><dialog id="journey-dialog"><form data-form="journey"><header><h2>Nova jornada</h2><button type="button" data-close>×</button></header><label>Nome<input name="name" required /></label><label>Gatilho<select name="triggerType"><option value="SegmentEntered">Entrada em segmento</option><option value="Birthday">Aniversário</option><option value="ServiceCompleted">Serviço concluído</option><option value="NpsDetractor">Cliente detrator</option><option value="InactiveClient">Cliente inativo</option><option value="MembershipDue">Assinatura vencendo</option><option value="BudgetAbandoned">Orçamento abandonado</option></select></label><label>Ação<select name="action"><option value="CreateFollowUp">Criar follow-up</option><option value="CreateTask">Criar tarefa interna</option><option value="Message">Criar comunicação</option><option value="CreateCoupon">Criar cupom</option></select></label><label>Janela sem duplicidade (horas)<input type="number" name="deduplicationHours" min="1" value="168" /></label><div class="form-error" data-form-error></div><footer><button type="button" data-close>Cancelar</button><button type="submit">Salvar jornada</button></footer></form></dialog>
}else if(page=="LandingPages"){
 <div class="section-title"><div><h2>Landing page builder</h2><p>Prévia responsiva com CTA para uma rota real.</p></div><button type="button" data-open="landing-dialog">Nova landing</button></div><div class="builder-grid"><div class="card-grid" data-list></div><aside class="landing-preview"><span>PRÉVIA</span><h2 data-preview-title>Sua oferta</h2><p data-preview-subtitle>Uma proposta clara para o cliente.</p><button type="button" disabled>CTA</button></aside></div><dialog id="landing-dialog"><form data-form="landing"><header><h2>Nova landing</h2><button type="button" data-close>×</button></header><label>Slug público<input name="slug" required pattern="[a-z0-9]+(-[a-z0-9]+)*" /></label><label>Título<input name="title" required maxlength="180" data-preview-input="title" /></label><label>Subtítulo<textarea name="subtitle" data-preview-input="subtitle"></textarea></label><label>Conteúdo<textarea name="body"></textarea></label><label>Tipo do CTA<select name="ctaType"><option value="Booking">Agendamento</option><option value="Store">Loja</option><option value="Portal">Portal</option><option value="Review">Avaliação</option><option value="None">Sem CTA</option></select></label><label>Texto do CTA<input name="ctaLabel" /></label><label>Rota do CTA<input type="url" name="ctaUrl" placeholder="https://" /></label><div class="form-error" data-form-error></div><footer><button type="button" data-close>Cancelar</button><button type="submit">Salvar rascunho</button></footer></form></dialog>
}else if(page=="PromoLinks"){
 <div class="section-title"><h2>Links rastreáveis</h2><button type="button" data-open="link-dialog">Criar link</button></div><div class="marketing-panel"><table><thead><tr><th>Slug</th><th>Destino</th><th>Status</th><th>Validade</th></tr></thead><tbody data-table></tbody></table><div class="empty" data-empty>Nenhum link real cadastrado.</div></div><dialog id="link-dialog"><form data-form="link"><header><h2>Novo link</h2><button type="button" data-close>×</button></header><label>Slug público<input name="publicSlug" required pattern="[a-z0-9-]+" /></label><label>Campanha<select name="campaignId" data-option="campaigns"><option value="">Sem campanha</option></select></label><label>Landing<select name="landingPageId" data-option="landings"><option value="">Sem landing</option></select></label><label>Tipo<select name="destinationType"><option value="Landing">Landing</option><option value="Booking">Agendamento</option><option value="Store">Loja</option><option value="Portal">Portal</option><option value="Review">Avaliação</option></select></label><label>Destino real<input type="url" name="destinationUrl" required /></label><label>Válido até<input type="datetime-local" name="validUntil" /></label><div class="form-error" data-form-error></div><footer><button type="button" data-close>Cancelar</button><button type="submit">Criar link</button></footer></form></dialog>
}else if(page=="QrCodes"){
 <div class="section-title"><h2>QR Codes de campanha</h2><button type="button" data-open="qr-dialog">Criar QR Code</button></div><div class="card-grid" data-list></div><dialog id="qr-dialog"><form data-form="qr"><header><h2>Novo QR Code</h2><button type="button" data-close>×</button></header><label>Nome<input name="name" required /></label><label>Link rastreável<select name="promoLinkId" required data-option="links"><option value="">Selecione</option></select></label><div class="form-error" data-form-error></div><footer><button type="button" data-close>Cancelar</button><button type="submit">Gerar QR</button></footer></form></dialog>
}else if(page=="Experiments"){
 <div class="section-title"><h2>Experimentos A/B</h2><button type="button" data-open="experiment-dialog">Criar experimento</button></div><div class="card-grid" data-list></div><dialog id="experiment-dialog" class="wide"><form data-form="experiment"><header><h2>Novo experimento</h2><button type="button" data-close>×</button></header><label>Nome<input name="name" required /></label><label>Campanha<select name="campaignId" required data-option="campaigns"><option value="">Selecione</option></select></label><label>Métrica<select name="metricKey"><option value="ClickRate">Taxa de clique</option><option value="BookingRate">Agendamento</option><option value="OrderRate">Pedido</option><option value="CouponRedemption">Cupom usado</option></select></label><div class="variants"><fieldset><legend>Variação A</legend><input name="labelA" required placeholder="Nome da variação" /><input type="number" name="allocationA" value="50" min="1" max="99" /><select name="templateA" required data-option="templates"><option value="">Template</option></select></fieldset><fieldset><legend>Variação B</legend><input name="labelB" required placeholder="Nome da variação" /><input type="number" name="allocationB" value="50" min="1" max="99" /><select name="templateB" required data-option="templates"><option value="">Template</option></select></fieldset></div><div class="form-error" data-form-error></div><footer><button type="button" data-close>Cancelar</button><button type="submit">Salvar experimento</button></footer></form></dialog>
}else if(page=="Calendar"){
 <div class="section-title"><div><h2>Calendário comercial</h2><p>Campanhas, promoções, feriados e lembretes.</p></div></div><div class="calendar" data-calendar><div class="empty">Os eventos cadastrados aparecerão aqui.</div></div>
}else if(page=="Reports"){
 <div class="marketing-panel"><h2>Resultados atribuídos</h2><p>Views, cliques, agendamentos, pedidos e receita vêm exclusivamente dos eventos persistidos.</p><a class="primary-link" href="/api/marketing/reports/export">Baixar relatório CSV</a></div>
}else{<div class="marketing-panel"><h2>Governança comercial</h2><p>Preferências, opt-out, suppression list e providers são respeitados antes de qualquer execução pelo módulo Comunicação.</p><a class="primary-link" href="/Communication/Settings">Revisar Comunicação</a></div>}
</main></section>
<script src="~/js/form-validation.js" asp-append-version="true"></script><script src="~/js/marketing.js" asp-append-version="true"></script>
