@{ViewData["Title"]="Auditoria Global";Layout="~/Views/Shared/_AdminLayout.cshtml";}
@section Styles{<link rel="stylesheet" href="~/css/platform-control.css" asp-append-version="true" />}
<main class="platform-page" data-platform-page="audit"><header class="platform-hero"><div><span>CONTROL PLANE</span><h1>Auditoria Global</h1><p>Ações críticas com ator, cliente, entidade, motivo e correlation ID.</p></div></header><section class="platform-error" data-error hidden><strong>Não foi possível carregar a auditoria.</strong><p></p><button type="button" data-retry>Tentar novamente</button></section><section class="platform-panel"><div class="responsive-table"><table><thead><tr><th>Quando</th><th>Ação</th><th>Módulo</th><th>Entidade</th><th>Ator</th><th>Motivo</th><th>Correlation ID</th></tr></thead><tbody data-audit></tbody></table></div><p class="platform-empty" data-empty hidden>Nenhum evento de auditoria para o filtro atual.</p></section></main>
@section Scripts{<script src="~/js/platform-control.js" asp-append-version="true"></script>}
