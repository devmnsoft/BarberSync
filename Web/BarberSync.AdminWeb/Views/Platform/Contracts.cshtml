@{ViewData["Title"]="Contratos de módulos";Layout="~/Views/Shared/_AdminLayout.cshtml";}
@section Styles{<link rel="stylesheet" href="~/css/platform-control.css" asp-append-version="true" />}
<main class="platform-page" data-platform-page="contracts"><header class="platform-hero"><div><span>CONTROL PLANE</span><h1>Contratos</h1><p>Plano base e add-ons permanecem separados, com valor negociado preservado.</p></div></header><section class="platform-error" data-error hidden><strong>Não foi possível carregar os contratos.</strong><p></p><button type="button" data-retry>Tentar novamente</button></section><section class="platform-panel"><div class="responsive-table"><table><thead><tr><th>Cliente</th><th>Módulo</th><th>Situação</th><th>Ciclo</th><th>Valor contratado</th><th>Início</th><th>Término</th></tr></thead><tbody data-contracts></tbody></table></div><p class="platform-empty" data-empty hidden>Nenhum contrato modular registrado.</p></section></main>
@section Scripts{<script src="~/js/platform-control.js" asp-append-version="true"></script>}
