@{ViewData["Title"]="Catálogo de Módulos";Layout="~/Views/Shared/_AdminLayout.cshtml";}
@section Styles{<link rel="stylesheet" href="~/css/platform-control.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/platform-forms.css" asp-append-version="true" />}
<main class="platform-page" data-platform-page="modules">
 <header class="platform-hero"><div><span>PLATAFORMA › CATÁLOGO</span><h1>Módulos</h1><p>Identidade comercial única, dependências, adoção e preços vigentes.</p></div><button class="platform-primary" type="button" data-new-module>Novo módulo</button></header>
 @Html.AntiForgeryToken()
 <section class="platform-error" data-error hidden><strong>Não foi possível carregar o catálogo.</strong><p></p><button type="button" data-retry>Tentar novamente</button></section><section class="module-cards" data-module-cards></section>
 <dialog class="platform-dialog" data-module-dialog><form method="dialog" data-module-form><header><div><small>CATÁLOGO COMERCIAL</small><h2 data-form-title>Novo módulo</h2></div><button type="button" data-close aria-label="Fechar">×</button></header><input name="id" type="hidden" /><label>Código estável<input name="moduleKey" required pattern="[A-Z0-9_]+" maxlength="80" placeholder="EXEMPLO_MODULO" /></label><label>Nome<input name="name" required maxlength="160" /></label><label>Categoria<input name="category" required maxlength="80" /></label><label>Descrição<textarea name="description" maxlength="1000"></textarea></label><div class="dialog-grid"><label>Status<select name="status"><option value="Active">Ativo</option><option value="Inactive">Inativo</option><option value="Archived">Arquivado</option></select></label><label>Ordem<input name="displayOrder" type="number" min="0" max="9999" value="100" /></label><label>Ícone<input name="iconKey" maxlength="80" /></label></div><div class="dialog-checks"><label><input name="isCore" type="checkbox" /> Módulo core</label><label><input name="isSellable" type="checkbox" checked /> Comercializável</label></div><p class="form-error" data-form-error hidden></p><footer><button type="button" data-close>Cancelar</button><button class="platform-primary" type="submit">Salvar módulo</button></footer></form></dialog>
 <dialog class="platform-dialog" data-price-dialog><form method="dialog" data-price-form><header><div><small>PREÇO VIGENTE</small><h2 data-price-title>Novo preço</h2></div><button type="button" data-close aria-label="Fechar">×</button></header><input name="moduleId" type="hidden" /><label>Ciclo<select name="billingCycle"><option value="Monthly">Mensal</option><option value="Annual">Anual</option><option value="OneTime">Único</option><option value="UsageBased">Por uso</option></select></label><div class="dialog-grid"><label>Moeda<input name="currency" value="BRL" pattern="[A-Z]{3}" maxlength="3" required /></label><label>Preço<input name="price" type="number" min="0" step="0.01" required /></label></div><label>Válido a partir de<input name="validFrom" type="datetime-local" required /></label><label>Válido até<input name="validUntil" type="datetime-local" /></label><input name="status" type="hidden" value="Active" /><p class="form-error" data-form-error hidden></p><footer><button type="button" data-close>Cancelar</button><button class="platform-primary" type="submit">Salvar preço</button></footer></form></dialog>
</main>
@section Scripts{<script src="~/js/platform-control.js" asp-append-version="true"></script>}
