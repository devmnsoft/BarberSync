@{ViewData["Title"]="Preços dos módulos";Layout="~/Views/Shared/_AdminLayout.cshtml";}
@section Styles{<link rel="stylesheet" href="~/css/platform-control.css" asp-append-version="true" />}
<main class="platform-page" data-platform-page="prices"><header class="platform-hero"><div><span>CONTROL PLANE</span><h1>Preços</h1><p>Histórico comercial por módulo, ciclo e vigência. Alterações não afetam contratos existentes.</p></div></header><section class="platform-error" data-error hidden><strong>Não foi possível carregar os preços.</strong><p></p><button type="button" data-retry>Tentar novamente</button></section><section class="platform-panel"><div class="responsive-table"><table><thead><tr><th>Módulo</th><th>Ciclo</th><th>Preço</th><th>Vigência</th><th>Status</th></tr></thead><tbody data-prices></tbody></table></div><p class="platform-empty" data-empty hidden>Preço não configurado para os módulos.</p></section></main>
@section Scripts{<script src="~/js/platform-control.js" asp-append-version="true"></script>}
