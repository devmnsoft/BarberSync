@{ViewData["Title"]="Detalhe do cliente";ViewData["TenantId"]=ViewData["TenantId"];Layout="~/Views/Shared/_AdminLayout.cshtml";}
@section Styles{<link rel="stylesheet" href="~/css/platform-control.css" asp-append-version="true" />}
<main class="platform-page" data-platform-page="tenant" data-tenant-id="@ViewData["TenantId"]">
 <header class="tenant-header"><div><span>CLIENTE SaaS</span><h1 data-tenant-name>Carregando…</h1><p><span data-tenant-document></span> <mark data-tenant-status></mark></p></div><form method="post" action="/Platform/Scope" class="scope-form">@Html.AntiForgeryToken()<input type="hidden" name="tenantId" value="@ViewData["TenantId"]" /><label>Motivo do acesso<input name="reason" required minlength="5" placeholder="Ex.: suporte solicitado pelo cliente" /></label><button class="platform-primary" type="submit">Entrar no contexto do cliente</button></form></header>
 <nav class="platform-tabs" aria-label="Detalhes do cliente"><button class="active" data-tab="overview">Visão Geral</button><button data-tab="modules">Módulos</button><button data-tab="users">Usuários</button><button data-tab="roles">Perfis</button><button data-tab="branches">Unidades</button><button data-tab="contract">Contrato</button><button data-tab="usage">Uso</button><button data-tab="audit">Auditoria</button></nav>
 <section class="platform-error" data-error hidden><strong>Não foi possível carregar o cliente.</strong><p></p><button type="button" data-retry>Tentar novamente</button></section>
 <section class="tenant-tab" data-tab-panel="overview"><div class="detail-grid" data-overview></div></section>
 <section class="tenant-tab" data-tab-panel="modules" hidden><div class="module-cards" data-tenant-modules></div></section>
 <section class="tenant-tab" data-tab-panel="users" hidden><div class="responsive-table"><table><thead><tr><th>Usuário</th><th>CPF</th><th>Perfil</th><th>Unidade</th><th>Status</th><th>Último acesso</th></tr></thead><tbody data-tenant-users></tbody></table></div></section>
 <section class="tenant-tab" data-tab-panel="roles" hidden><div class="responsive-table"><table><thead><tr><th>Perfil</th><th>Código</th><th>Usuários</th><th>Permissões</th></tr></thead><tbody data-tenant-roles></tbody></table></div></section>
 <section class="tenant-tab" data-tab-panel="branches" hidden><div class="responsive-table"><table><thead><tr><th>Unidade</th><th>Código</th><th>Usuários</th><th>Profissionais</th><th>Status</th></tr></thead><tbody data-tenant-branches></tbody></table></div></section>
 <section class="tenant-tab" data-tab-panel="contract" hidden><div class="detail-grid" data-tenant-contract></div><div class="module-cards" data-contract-modules></div></section>
 <section class="tenant-tab" data-tab-panel="usage" hidden><div class="responsive-table"><table><thead><tr><th>Data</th><th>Módulo</th><th>Usuários ativos</th><th>Requests</th><th>Operações</th><th>Unidades</th></tr></thead><tbody data-tenant-usage></tbody></table></div><p class="platform-empty" data-usage-empty hidden>Sem agregados de uso no período.</p></section>
 <section class="tenant-tab" data-tab-panel="audit" hidden><p><a class="platform-primary" href="/Platform/Audit?tenantId=@ViewData["TenantId"]">Abrir auditoria filtrada deste cliente</a></p></section>
</main>
@section Scripts{<script src="~/js/platform-control.js" asp-append-version="true"></script>}
