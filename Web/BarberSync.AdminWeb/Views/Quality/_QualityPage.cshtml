@{Layout="~/Views/Shared/_AdminLayout.cshtml";var page=(string)(ViewData["QualityPage"]??"Index");}
<link rel="stylesheet" href="~/css/quality.css" asp-append-version="true" />
<section class="quality-shell" data-quality-page="@page">
 <header class="quality-hero"><div><span class="quality-eyebrow">Experiência pós-atendimento</span><h1>Qualidade &amp; Retenção</h1><p>Transforme feedback real em decisões, recuperação e retorno no momento certo.</p></div><a class="quality-export" href="/api/quality/reports/export">Exportar CSV</a></header>
 <nav class="quality-nav" aria-label="Qualidade e retenção"><a href="/Quality">Visão geral</a><a href="/Quality/Reviews">Avaliações</a><a href="/Quality/Nps">NPS</a><a href="/Quality/Recovery">Recuperação</a><a href="/Quality/FollowUps">Follow-ups</a><a href="/Quality/Retention">Retenção</a><a href="/Quality/Reputation">Reputação</a><a href="/Quality/Reports">Relatórios</a><a href="/Quality/Settings">Configurações</a></nav>
 <form class="quality-filters" data-quality-filters><label>De<input type="date" name="from" /></label><label>Até<input type="date" name="to" /></label><label>Profissional<select name="professionalId"><option value="">Todos</option></select></label><label>Serviço<select name="serviceId"><option value="">Todos</option></select></label><button type="submit">Aplicar filtros</button></form>
 <div class="quality-error" data-quality-error hidden><strong>Não foi possível carregar.</strong><span></span><button type="button" data-quality-retry>Tentar novamente</button></div>
 <div class="quality-loading" data-quality-loading aria-live="polite"><i></i><i></i><i></i><span>Carregando indicadores reais…</span></div>
 <main data-quality-content hidden>
 @if(page=="Index"){
  <div class="quality-kpis"><article><span>NPS</span><strong data-kpi="nps_score">—</strong><small>promotores menos detratores</small></article><article><span>Rating médio</span><strong data-kpi="average_rating">—</strong><small data-kpi-note="reviews_count">avaliações</small></article><article><span>Recuperados</span><strong data-kpi="recovered">—</strong><small>ações concluídas</small></article><article><span>Follow-ups vencidos</span><strong data-kpi="follow_ups_overdue">—</strong><small>ação sugerida hoje</small></article></div>
  <div class="quality-grid"><article class="quality-panel"><header><h2>Funil de experiência</h2><span class="pill calm">Período</span></header><div class="quality-funnel" data-funnel></div></article><article class="quality-panel"><header><h2>Decisões prioritárias</h2></header><div class="quality-empty" data-priorities>Nenhum alerta no período selecionado.</div></article></div>
 } else if(page=="Recovery"){
  <div class="quality-section-title"><div><h2>Kanban de recuperação</h2><p>Casos reais organizados pela próxima ação.</p></div><button type="button" data-open-dialog="case-dialog">Criar caso</button></div><div class="quality-kanban" data-recovery-board></div>
  <dialog id="case-dialog"><form method="dialog" data-quality-form="case"><header><h2>Novo caso de recuperação</h2><button value="cancel" aria-label="Fechar">×</button></header><label>Cliente<select name="clientId" required><option value="">Selecione</option></select><span data-field-error="clientId"></span></label><label>Responsável<select name="assignedTo" required><option value="">Selecione</option></select></label><label>Origem<select name="caseType" required><option value="Detractor">Cliente detrator</option><option value="Complaint">Reclamação</option><option value="NoShow">No-show recorrente</option><option value="InactiveVip">VIP inativo</option><option value="CancelledMembership">Clube cancelado</option><option value="Manual">Análise manual</option></select></label><label>Severidade<select name="severity"><option>Medium</option><option>Low</option><option>High</option><option>Critical</option></select></label><label>Motivo<textarea name="reason" required maxlength="500"></textarea></label><label>Resumo<textarea name="summary" required maxlength="1000"></textarea></label><div class="form-error" data-form-error></div><footer><button value="cancel">Cancelar</button><button type="submit">Abrir caso</button></footer></form></dialog>
 } else if(page=="FollowUps"){
  <div class="quality-section-title"><div><h2>Fila de follow-ups</h2><p>Retornos pendentes e vencidos, sem duplicidade por origem.</p></div><button type="button" data-open-dialog="followup-dialog">Novo follow-up</button></div><div class="quality-table-wrap"><table><thead><tr><th>Cliente</th><th>Ação</th><th>Prazo</th><th>Status</th><th>Responsável</th><th></th></tr></thead><tbody data-followups></tbody></table></div><div class="quality-empty" data-followups-empty hidden>Nenhum follow-up para os filtros atuais.</div>
  <dialog id="followup-dialog"><form method="dialog" data-quality-form="followup"><header><h2>Novo follow-up</h2><button value="cancel" aria-label="Fechar">×</button></header><label>Cliente<select name="clientId" required><option value="">Selecione</option></select></label><label>Responsável<select name="responsibleId" required><option value="">Selecione</option></select></label><label>Título<input name="title" required maxlength="180" autocomplete="off" /></label><label>Prazo<input type="datetime-local" name="dueAt" required /></label><label>Orientação<textarea name="description" maxlength="1000"></textarea></label><input type="hidden" name="sourceType" value="Manual" /><div class="form-error" data-form-error></div><footer><button value="cancel">Cancelar</button><button type="submit">Salvar follow-up</button></footer></form></dialog>
 } else if(page=="Settings"){
  <div class="quality-grid"><article class="quality-panel"><header><h2>Regras de retorno por serviço</h2></header><form data-quality-form="return-rule"><label>Serviço<select name="serviceId" required><option value="">Selecione</option></select></label><div class="quality-days"><label>Mínimo<input type="number" name="minDays" min="0" required /></label><label>Recomendado<input type="number" name="recommendedDays" min="0" required /></label><label>Máximo<input type="number" name="maxDays" min="0" required /></label></div><label>Mensagem<textarea name="message" maxlength="500"></textarea></label><button type="submit">Salvar regra</button><div class="form-error" data-form-error></div></form><div data-return-rules></div></article><article class="quality-panel"><header><h2>Governança</h2></header><p>Alertas e automações respeitam permissões, opt-in e suppression list. Créditos nunca são concedidos automaticamente.</p><a class="quality-inline-link" href="/Communication/Automations">Revisar automações de comunicação</a></article></div>
 } else {
  <div class="quality-section-title"><div><h2>@ViewData["Title"]</h2><p data-quality-description>Dados consolidados da operação, sem estimativas ou conteúdo demonstrativo.</p></div></div><div class="quality-panel" data-quality-list></div><div class="quality-empty" data-quality-empty hidden>Nenhum registro real encontrado no período.</div>
 }
 </main>
</section>
<script src="~/js/form-validation.js" asp-append-version="true"></script><script src="~/js/quality.js" asp-append-version="true"></script>
