@{ ViewData["Title"] = "Agenda inteligente"; Layout = "~/Views/Shared/_AdminLayout.cshtml"; }
<link rel="stylesheet" href="~/css/scheduling.css" asp-append-version="true" />
<main class="schedule-shell" data-scheduling-root>
  <header class="schedule-hero"><div><span class="eyebrow">OPERAÇÃO EM TEMPO REAL</span><h1>Agenda inteligente</h1><p>Disponibilidade, confirmações e atendimento em uma única linha do tempo.</p></div><div class="hero-actions"><a class="btn btn-light" href="/Scheduling/Waitlist">Lista de espera</a><button class="btn btn-primary" type="button" data-open-booking>Novo agendamento</button></div></header>
  <section class="schedule-kpis" aria-label="Indicadores do dia" data-kpis>
    @foreach (var item in new[]{("calendar","Agendados hoje"),("check","Confirmados"),("clock","Aguardando confirmação"),("person","Check-ins"),("warning","No-shows"),("list","Lista de espera"),("spark","Horários livres"),("team","Profissionais disponíveis")}) { <article class="schedule-kpi skeleton"><span>@item.Item2</span><strong>—</strong></article> }
  </section>
  <section class="schedule-toolbar panel"><div class="view-switch" role="group" aria-label="Modo do calendário"><button type="button" class="is-active" data-view="day">Dia</button><button type="button" data-view="week">Semana</button><button type="button" data-view="month">Mês</button></div><button class="date-nav" type="button" data-previous aria-label="Período anterior">‹</button><input type="date" data-date aria-label="Data da agenda" /><button class="date-nav" type="button" data-next aria-label="Próximo período">›</button><select data-professional aria-label="Filtrar por profissional"><option value="">Todos os profissionais</option></select><select data-service aria-label="Filtrar por serviço"><option value="">Todos os serviços</option></select><select data-status aria-label="Filtrar por status"><option value="">Todos os status</option><option value="Scheduled">Agendado</option><option value="Confirmed">Confirmado</option><option value="CheckedIn">Check-in</option><option value="InService">Em atendimento</option><option value="Cancelled">Cancelado</option><option value="NoShow">No-show</option></select></section>
  <div class="schedule-error panel" data-error hidden><strong>Não foi possível atualizar a agenda.</strong><p data-error-message></p><small data-trace></small><button class="btn btn-primary" type="button" data-retry>Tentar novamente</button></div>
  <section class="calendar-stage panel" data-calendar aria-live="polite"><div class="calendar-loading">Preparando horários disponíveis…</div></section>
</main>
<dialog class="schedule-modal" data-booking-dialog><form method="dialog" data-booking-form><header><div><span class="eyebrow">NOVO AGENDAMENTO</span><h2 data-modal-title>Escolha o cliente</h2></div><button type="button" class="modal-x" data-close aria-label="Fechar">×</button></header><ol class="wizard-steps"><li class="active">Cliente</li><li>Serviço</li><li>Profissional</li><li>Horário</li><li>Resumo</li></ol><div class="wizard-body" data-wizard-body></div><footer><button class="btn btn-light" type="button" data-back>Voltar</button><button class="btn btn-primary" type="button" data-next-step>Continuar</button></footer></form></dialog>
<dialog class="schedule-modal compact" data-action-dialog><form method="dialog" data-action-form><header><h2 data-action-title>Atualizar agendamento</h2><button type="button" class="modal-x" data-action-close aria-label="Fechar">×</button></header><div data-action-body></div><footer><button class="btn btn-light" type="button" data-action-close>Voltar</button><button class="btn btn-primary" type="submit">Confirmar</button></footer></form></dialog>
@section Scripts { <script src="~/js/scheduling.js" asp-append-version="true"></script> }
