@{ ViewData["Title"] = "Políticas da agenda"; Layout = "~/Views/Shared/_AdminLayout.cshtml"; }
<link rel="stylesheet" href="~/css/scheduling.css" asp-append-version="true" /><main class="schedule-shell"><header class="schedule-hero"><div><span class="eyebrow">CONFIGURAÇÕES</span><h1>Políticas da agenda</h1><p>Defina antecedência, confirmação, cancelamento e autoatendimento.</p></div><a class="btn btn-light" href="/Scheduling">Voltar à agenda</a></header><form class="settings-grid panel" data-policy-form><label>Nome da política<input name="name" required maxlength="120" /></label><label>Antecedência mínima (minutos)<input name="minAdvanceMinutes" type="number" min="0" required /></label><label>Janela máxima (dias)<input name="maxAdvanceDays" type="number" min="1" required /></label><label>Limite para cancelamento (minutos)<input name="cancellationLimitMinutes" type="number" min="0" required /></label><label>Limite para reagendamento (minutos)<input name="rescheduleLimitMinutes" type="number" min="0" required /></label><label>Intervalo entre atendimentos (minutos)<input name="bufferMinutes" type="number" min="0" required /></label><label class="check"><input name="allowOnlineBooking" type="checkbox" /> Permitir agendamento online</label><label class="check"><input name="allowWaitlist" type="checkbox" /> Permitir lista de espera</label><label class="check"><input name="requireConfirmation" type="checkbox" /> Exigir confirmação</label><label class="check"><input name="requireCancellationReason" type="checkbox" /> Exigir motivo ao cancelar</label><div class="form-actions"><button class="btn btn-primary" type="submit">Salvar política</button></div></form></main>
@section Scripts { <script src="~/js/scheduling.js" asp-append-version="true"></script> }
