@{ ViewData["Title"] = "Lista de espera"; Layout = "~/Views/Shared/_AdminLayout.cshtml"; }
<link rel="stylesheet" href="~/css/scheduling.css" asp-append-version="true" />
<main class="schedule-shell" data-waitlist-root><header class="schedule-hero"><div><span class="eyebrow">OPORTUNIDADES DE ENCAIXE</span><h1>Lista de espera</h1><p>Priorize clientes e converta horários liberados sem perder o contexto.</p></div><div class="hero-actions"><a class="btn btn-light" href="/Scheduling">Voltar à agenda</a><button class="btn btn-primary" type="button" data-waitlist-new>Adicionar cliente</button></div></header><section class="schedule-toolbar panel"><input type="date" data-waitlist-date aria-label="Data preferida"/><select data-waitlist-period aria-label="Período"><option value="">Todos os períodos</option><option value="Morning">Manhã</option><option value="Afternoon">Tarde</option><option value="Evening">Noite</option><option value="Any">Qualquer período</option></select><select data-waitlist-status aria-label="Situação"><option value="Waiting">Aguardando</option><option value="Offered">Horário oferecido</option><option value="Booked">Agendado</option></select></section><section class="waitlist-board" data-waitlist><div class="calendar-loading">Carregando lista de espera…</div></section></main>
@section Scripts { <script src="~/js/scheduling.js" asp-append-version="true"></script> }
