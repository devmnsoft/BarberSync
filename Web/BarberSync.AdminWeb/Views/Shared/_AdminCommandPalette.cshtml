        <div class="command-palette-header"><div><span class="modal-kicker">BUSCA GLOBAL</span><h3>Encontre e execute</h3></div><button type="button" class="modal-close" data-command-close aria-label="Fechar busca">×</button></div>
        <label class="command-search"><span aria-hidden="true">Buscar</span><input id="AdminCommandSearch" type="search" placeholder="Cliente, telefone, agenda, comanda, produto ou serviço" autocomplete="off" /><kbd>Ctrl K</kbd></label>
