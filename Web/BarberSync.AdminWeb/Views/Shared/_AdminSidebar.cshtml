@{
    var path = Context.Request.Path.Value?.TrimEnd('/').ToLowerInvariant() ?? string.Empty;
    Func<string, string> active = href => path == href.ToLowerInvariant() || path.StartsWith($"{href.ToLowerInvariant()}/") ? "active" : string.Empty;
    var canManageSystem = User.IsInRole("SuperAdmin") || User.IsInRole("Owner") || User.IsInRole("Admin");
}
<aside class="admin-sidebar" aria-label="Navegação principal">
    <a class="brand" href="/Admin/Dashboard" aria-label="BarberSync — Visão geral">
        <img src="~/img/logo-barbersync-white.svg" alt="" />
        <div><strong>BarberSync</strong><small>Gestão premium</small></div>
    </a>
    <nav class="journey-nav">
        <div class="menu-section"><h6>OPERAÇÃO</h6>
            <a class="menu-link @active("/admin/dashboard")" href="/Admin/Dashboard"><svg class="nav-icon"><use href="#i-grid" /></svg><span>Visão geral</span></a>
            <a class="menu-link @active("/admin/appointments")" href="/Admin/Appointments"><svg class="nav-icon"><use href="#i-calendar" /></svg><span>Agenda</span></a>
            <a class="menu-link @active("/operation")" href="/Operation/Today"><svg class="nav-icon"><use href="#i-user-check" /></svg><span>Operação do dia</span></a>
        </div>
        <div class="menu-section"><h6>PDV / CAIXA</h6>
            <a class="menu-link @active("/operation/serviceorders") @active("/admin/serviceorders")" href="/Operation/ServiceOrders"><svg class="nav-icon"><use href="#i-receipt" /></svg><span>Comandas</span></a>
            <a class="menu-link @active("/operation/cash") @active("/admin/cash")" href="/Operation/Cash"><svg class="nav-icon"><use href="#i-wallet" /></svg><span>Caixa</span></a>
        </div>
        <div class="menu-section"><h6>CLIENTES</h6>
            <a class="menu-link @active("/relationship")" href="/Relationship"><svg class="nav-icon"><use href="#i-users" /></svg><span>Relacionamento</span></a>
            <a class="menu-link @active("/admin/clients")" href="/Relationship/Clients"><svg class="nav-icon"><use href="#i-users" /></svg><span>Clientes</span></a>
            <a class="menu-link @active("/admin/loyalty")" href="/Relationship/Loyalty"><svg class="nav-icon"><use href="#i-gift" /></svg><span>Fidelidade</span></a>
        </div>
        <div class="menu-section"><h6>COMERCIAL</h6>
            <a class="menu-link @active("/admin/services")" href="/Admin/Services"><svg class="nav-icon"><use href="#i-tag" /></svg><span>Serviços</span></a>
            <a class="menu-link @active("/admin/packages")" href="/Relationship/Packages"><svg class="nav-icon"><use href="#i-gift" /></svg><span>Pacotes</span></a>
            <a class="menu-link @active("/admin/coupons")" href="/Relationship/Coupons"><svg class="nav-icon"><use href="#i-gift" /></svg><span>Cupons</span></a>
            <a class="menu-link @active("/admin/memberships")" href="/Admin/Memberships"><svg class="nav-icon"><use href="#i-star" /></svg><span>Assinaturas</span></a>
            <a class="menu-link @active("/admin/campaigns")" href="/Relationship/Campaigns"><svg class="nav-icon"><use href="#i-megaphone" /></svg><span>Campanhas</span></a>
        </div>
        <div class="menu-section"><h6>EQUIPE</h6>
            <a class="menu-link @active("/admin/professionals")" href="/Admin/Professionals"><svg class="nav-icon"><use href="#i-scissors" /></svg><span>Profissionais</span></a>
            <a class="menu-link @active("/admin/commissions")" href="/Admin/Commissions"><svg class="nav-icon"><use href="#i-coins" /></svg><span>Comissões</span></a>
        </div>
        <div class="menu-section"><h6>ESTOQUE</h6>
            <a class="menu-link @active("/admin/products")" href="/Admin/Products"><svg class="nav-icon"><use href="#i-box" /></svg><span>Produtos</span></a>
            <a class="menu-link @active("/admin/stock")" href="/Admin/Stock"><svg class="nav-icon"><use href="#i-package" /></svg><span>Movimentações</span></a>
            <a class="menu-link @active("/admin/suppliers")" href="/Admin/Suppliers"><svg class="nav-icon"><use href="#i-building" /></svg><span>Fornecedores</span></a>
            <a class="menu-link @active("/admin/purchases")" href="/Admin/Purchases"><svg class="nav-icon"><use href="#i-receipt" /></svg><span>Compras</span></a>
        </div>
        <div class="menu-section"><h6>FINANCEIRO</h6>
            <a class="menu-link @active("/admin/financial")" href="/Admin/Financial"><svg class="nav-icon"><use href="#i-coins" /></svg><span>Visão financeira</span></a>
        </div>
        <div class="menu-section"><h6>RELATÓRIOS</h6>
            <a class="menu-link @active("/admin/reports")" href="/Admin/Reports"><svg class="nav-icon"><use href="#i-chart" /></svg><span>Relatórios</span></a>
            <a class="menu-link @active("/admin/audit")" href="/Admin/Audit"><svg class="nav-icon"><use href="#i-history" /></svg><span>Auditoria</span></a>
        </div>
