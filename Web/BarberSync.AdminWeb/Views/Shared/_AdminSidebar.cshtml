@inject BarberSync.AdminWeb.Services.Navigation.IModuleNavigationService Navigation
@{
    var path=Context.Request.Path.Value?.TrimEnd('/').ToLowerInvariant()??string.Empty;
    var groups=Navigation.Build(User,path);
    Func<string,bool> active=href=>path==href.ToLowerInvariant()||path.StartsWith($"{href.ToLowerInvariant()}/");
}
<aside class="admin-sidebar" aria-label="Navegação principal">
    <a class="brand" href="@(User.HasClaim("platform_admin","true")?"/Platform":"/Admin/Dashboard")" aria-label="BarberSync — início">
        <img src="~/img/logo-barbersync-white.svg" alt="" />
        <div><strong>BarberSync</strong><small>@(User.HasClaim("platform_admin","true")?"Plataforma SaaS":"Gestão premium")</small></div>
    </a>
    <nav class="journey-nav" data-module-navigation>
        @foreach(var group in groups)
        {
            var expanded=group.Items.Any(item=>active(item.Href));
            <details class="menu-group @(group.IsPlatform?"is-platform":null)" data-menu-group="@group.Key" open="@(expanded?"open":null)">
                <summary aria-label="@group.Label"><span>@group.Label</span><svg class="group-chevron" aria-hidden="true"><use href="#i-chevron" /></svg></summary>
                <div class="menu-group-items">
                    @foreach(var item in group.Items)
                    {
                        <a class="menu-link @(active(item.Href)?"active":null)" href="@item.Href" title="@item.Label" aria-current="@(active(item.Href)?"page":null)">
                            <svg class="nav-icon" aria-hidden="true"><use href="#i-@item.Icon" /></svg><span>@item.Label</span>
                        </a>
                    }
                </div>
            </details>
        }
    </nav>
</aside>
