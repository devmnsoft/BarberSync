            <a class="menu-link @active("/admin/branches")" href="/Admin/Branches"><svg class="nav-icon"><use href="#i-building" /></svg><span>Unidades</span></a>
            <a class="menu-link @active("/admin/users")" href="/Admin/Users"><svg class="nav-icon"><use href="#i-shield" /></svg><span>Usuários e perfis</span></a>
            @if (canManageSystem) { <a class="menu-link @active("/admin/systemhealth")" href="/Admin/SystemHealth"><svg class="nav-icon"><use href="#i-monitor" /></svg><span>Saúde do sistema</span></a> }
            <a class="menu-link @active("/admin/settings")" href="/Admin/Settings"><svg class="nav-icon"><use href="#i-settings" /></svg><span>Configurações</span></a>
        </div>
    </nav>
</aside>
