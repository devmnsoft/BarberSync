@{ var pageTitle = ViewData["Title"]?.ToString() ?? "Visão Geral"; }
<header class="admin-topbar">
    <button class="icon-button" type="button" data-sidebar-toggle aria-label="Alternar menu"><span aria-hidden="true">Menu</span></button>
    <div class="topbar-context">
        <nav class="breadcrumb" aria-label="Navegação estrutural"><a href="/Admin/Dashboard">BarberSync</a><span>/</span><strong>@pageTitle</strong></nav>
        <span class="active-unit">Unidade <strong data-active-unit>Principal</strong></span>
    </div>
    <button class="global-search-trigger" type="button" data-command-open>
        <span>Buscar clientes, agenda, comandas...</span><kbd>Ctrl K</kbd>
    </button>
    <a class="icon-button notification-button" href="/Admin/Notifications" aria-label="Notificações">Notificações<span class="notification-dot" data-topbar-notification-count>0</span></a>
    <a class="icon-button" href="/Admin/Help">Ajuda</a>
    <button class="user-menu" type="button" aria-label="Abrir menu do usuário"><span class="avatar">BS</span><span><strong>Minha conta</strong><small>Administrador</small></span></button>
</header>
