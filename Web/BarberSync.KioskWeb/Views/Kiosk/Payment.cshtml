@{Layout="~/Views/Shared/_KioskLayout.cshtml"; ViewData["Title"]="Finalizar";}
<section class="kiosk-step">
  <div class="kiosk-progress"><span style="width:88%"></span></div>
  <img class="kiosk-illustration" src="~/img/kiosk-payment.svg" alt="Finalização do atendimento"/>
  <h1>Como deseja continuar?</h1>
  <p>O atendimento será registrado e enviado ao caixa. O totem não confirma pagamentos sem um provedor configurado.</p>
  <div class="payment-options"><button type="button" data-payment="Caixa">Pagar no caixa</button><button type="button" data-payment="Atendente">Chamar atendente</button></div>
  <button id="kioskPay" class="k-btn">Enviar atendimento ao caixa</button>
</section>
