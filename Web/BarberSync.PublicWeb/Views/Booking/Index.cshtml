@{ ViewData["Title"] = "Agendar horário"; }
<link rel="stylesheet" href="~/css/public-booking.css" asp-append-version="true" />
<main class="booking-page"><section class="booking-brand"><span>BARBERSYNC</span><h1>Seu próximo cuidado começa aqui.</h1><p>Escolha serviço, profissional e horário. A disponibilidade é confirmada diretamente com a unidade.</p><div class="booking-trust"><strong>Agendamento seguro</strong><small>Nenhum dado técnico é solicitado.</small></div></section><section class="booking-panel" data-public-booking><header><span data-progress-label>Etapa 1 de 5</span><div class="progress"><i data-progress></i></div><h2 data-title>Qual serviço você deseja?</h2></header><div class="booking-content" data-content><div class="booking-loading">Consultando serviços da unidade…</div></div><div class="booking-error" data-error hidden><strong>Não conseguimos acessar a agenda agora.</strong><p data-error-message></p><small data-trace></small><button type="button" data-retry>Tentar novamente</button></div><footer><button type="button" class="secondary" data-back>Voltar</button><button type="button" class="primary" data-next>Continuar</button></footer></section></main>
@section Scripts { <script src="~/js/public-booking.js" asp-append-version="true"></script> }
