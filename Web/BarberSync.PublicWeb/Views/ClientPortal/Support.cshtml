@{ var page=(string?)ViewData["PortalPage"] ?? "Home"; ViewData["Title"]="Portal do Cliente"; }
<link rel="stylesheet" href="~/css/client-portal.css" asp-append-version="true" />
<div class="portal-shell" data-portal-page="@page"><header class="portal-header"><a class="portal-brand" asp-controller="ClientPortal" asp-action="Home">BARBERSYNC <small>meu espaço</small></a><button type="button" data-logout>Sair com segurança</button></header><nav class="portal-tabs" aria-label="Navegação do portal"><a asp-action="Home">Início</a><a asp-action="Appointments">Agenda</a><a asp-action="History">Histórico</a><a asp-action="Consents">Cuidados</a><a asp-action="Budgets">Orçamentos</a><a asp-action="TreatmentPlans">Planos</a><a asp-action="Payments">Pagamentos</a><a asp-action="Benefits">Benefícios</a><a asp-action="Reviews">Avaliar</a><a asp-action="Preferences">Preferências</a><a asp-action="Support">Ajuda</a></nav><main class="portal-main"><section class="portal-title"><span>Seu espaço</span><h1 data-page-title>Carregando seu espaço…</h1><p data-page-subtitle>Informações atualizadas diretamente pela sua unidade.</p></section><div class="portal-error" data-error hidden><strong>Não conseguimos carregar agora.</strong><p data-error-message></p><small data-trace></small><button type="button" data-retry>Tentar novamente</button></div><div class="portal-skeleton" data-loading><i></i><i></i><i></i></div><section data-content hidden></section></main></div>
