@model BarberSync.PublicWeb.Controllers.MarketingPublicController.LandingModel
@{Layout=null;var unavailable=ViewData["Unavailable"] as bool? == true;}
<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>@(unavailable?"Oferta indisponível":Model?.Title)</title><link rel="stylesheet" href="~/css/marketing-public.css" asp-append-version="true"/></head><body data-marketing-landing="@Model?.Slug">
<main class="promo-shell">
@if(unavailable){<section class="unavailable"><span>Oferta encerrada</span><h1>Esta experiência não está disponível.</h1><p>O link pode ter expirado ou a campanha foi pausada. Explore os canais oficiais do estabelecimento para descobrir outras opções.</p><a href="/">Voltar ao início</a>@if(ViewData["TraceId"] is string trace){<small>traceId: @trace</small>}</section>}
else{<section class="promo-hero"><div><span class="eyebrow">Uma experiência BarberSync</span><h1>@Model?.Title</h1><p>@Model?.Subtitle</p>@if(Model?.CtaType!="None"&&!string.IsNullOrWhiteSpace(Model?.CtaUrl)){<a class="cta" href="@Model.CtaUrl" data-marketing-cta>@(Model.CtaLabel??"Quero aproveitar")</a>}</div><aside><span>Oferta personalizada</span><strong>Benefícios claros.<br/>Próximo passo simples.</strong></aside></section><section class="benefits"><article><span>01</span><h2>Experiência conectada</h2><p>Da descoberta ao agendamento em uma jornada fluida.</p></article><article><span>02</span><h2>Condições transparentes</h2><p>Consulte disponibilidade e validade nos canais oficiais.</p></article><article><span>03</span><h2>Atendimento premium</h2><p>Escolha o melhor momento para cuidar de você.</p></article></section><section class="story"><span>SELECIONADO PARA VOCÊ</span><p>@Model?.Body</p></section>}
</main><script src="~/js/marketing-public.js" asp-append-version="true"></script></body></html>
