@{ ViewData["Title"]="Finalizar pedido"; }<link rel="stylesheet" href="~/css/public-store.css" asp-append-version="true"><main class="store"><header><span>Checkout</span><h1>Confirme seus dados</h1><p>O pedido nasce aguardando pagamento; nenhum benefício é liberado antecipadamente.</p></header><form class="checkout" data-store-checkout><label>Nome completo<input name="buyerName" autocomplete="name" required></label><label>E-mail<input name="buyerEmail" type="email" autocomplete="email" required></label><label>Telefone<input name="buyerPhone" type="tel" autocomplete="tel"></label><label>Beneficiário (opcional)<input name="beneficiaryName" autocomplete="name"></label><button type="submit">Criar pedido</button><p data-checkout-status></p></form></main><script src="~/js/public-store.js" asp-append-version="true"></script>
